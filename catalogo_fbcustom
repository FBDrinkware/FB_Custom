.fbd-dots button.on{width:26px;background:var(--lime)}
footer .copy{display:flex;flex-direction:column;gap:4px;align-items:center}

/* ===== Diséñalo (promo en inicio) ===== */
.dz-promo{background:var(--card);border-block:1px solid var(--line)}
.dz-promo-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:clamp(24px,5vw,64px);align-items:center}
@media (max-width:820px){.dz-promo-in{grid-template-columns:1fr}}
