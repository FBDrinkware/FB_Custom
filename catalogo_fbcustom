      r=s.r*light*(1+bev*0.15)+detail*sh.tex*0.8+sat;g=s.g*light*(1+bev*0.15)+detail*sh.tex*0.8+sat;b=s.b*light*(1+bev*0.15)+detail*sh.tex*0.8+sat;
    }else{ // bordado
      r=s.r*light*(1+bev*0.55)+detail*sh.tex*0.35;g=s.g*light*(1+bev*0.55)+detail*sh.tex*0.35;b=s.b*light*(1+bev*0.55)+detail*sh.tex*0.35;
    }
    const a=Math.min(1,s.a)*(tech==="laser"?0.96:1);
    pd[pi]=Math.max(0,Math.min(255,base[0]*(1-a)+r*a));
    pd[pi+1]=Math.max(0,Math.min(255,base[1]*(1-a)+g*a));
    pd[pi+2]=Math.max(0,Math.min(255,base[2]*(1-a)+b*a));
  }
  ox.putImageData(reg,bx0,by0);
  return out.toDataURL("image/png");
}


