  .hero.banner::after{display:none}
  .hero.banner .banner-in{padding-block:28px 36px}
}

/* ===== FB DESIGN · carrusel ===== */
.fbd-band{padding-block:clamp(48px,7vw,84px)}
.fbd{position:relative;background:var(--ink);color:#fff;border-radius:22px;overflow:hidden}
.fbd-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
.fbd-track::-webkit-scrollbar{display:none}
.fbd-slide{flex:0 0 100%;scroll-snap-align:start;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);align-items:center;gap:24px;padding:clamp(24px,4vw,44px) clamp(20px,4vw,48px);min-height:340px}
.fbd-slide img{width:100%;max-height:300px;object-fit:contain;justify-self:center}
@media (max-width:760px){.fbd-slide{grid-template-columns:1fr}.fbd-slide img{max-height:220px;order:-1}}
.fbd-copy{display:grid;gap:14px;justify-items:start;min-width:0}
.fbd-top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.fbd-wm{font-family:var(--display);font-weight:700;font-size:18px;letter-spacing:.01em;color:#fff}
.fbd-wm b{color:var(--lime);margin-right:5px}
.fbd-soon{font-family:var(--display);font-size:11px;letter-spacing:.16em;text-transform:uppercase;border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:3px 10px;color:#D6D6CE}
.fbd h2{font-size:clamp(26px,3.2vw,38px);line-height:1.05;color:#fff;margin:0}
.fbd p{color:#C9C9C1;margin:0;max-width:30em}
.fbd-vs{display:grid;grid-template-columns:1fr 1fr;gap:10px;width:100%;max-width:34em}
