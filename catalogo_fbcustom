/* ---- Carrito ---- */
let cart=[];
try{cart=JSON.parse(localStorage.getItem("fbcart")||"[]")||[];}catch(_){cart=[];}
function saveCart(){try{localStorage.setItem("fbcart",JSON.stringify(cart));}catch(_){}updateBadge();}
function updateBadge(){const q=document.getElementById("qcount");q.hidden=!cart.length;q.textContent=cart.length;}
async function thumb(src){const im=await loadImg(src);const s=360,c=document.createElement("canvas");c.width=s;c.height=s;const x=c.getContext("2d");
  x.fillStyle="#E9ECF2";x.fillRect(0,0,s,s);const k=Math.min(s*0.88/im.width,s*0.88/im.height);
  x.drawImage(im,(s-im.width*k)/2,(s-im.height*k)/2,im.width*k,im.height*k);
  try{const w=c.toDataURL("image/webp",0.85);if(w.startsWith("data:image/webp"))return w;}catch(_){}
  return c.toDataURL("image/jpeg",0.85);}
document.getElementById("addCart").addEventListener("click",async()=>{
  if(!dz.result)return;const p=curP();const pcs=Math.max(1,parseInt(document.getElementById("qty").value)||1);
  cart.push({id:Date.now(),pid:p.id,name:p.sheet?p.sheet[dz.color].name:p.name,sku:p.sheet?dz.color:p.sku,cat:p.cat,comp:p.sheet?`Capacidad ${p.sheet[dz.color].cap} · Acero inoxidable`:p.specs?`${p.specs.mat} · Capacidad ${p.specs.cap} · ${p.specs.prop}`:p.comp,color:dz.color,tech:dz.tech,place:(p.cat==="drinkware"?`${ORI_N[dz.orient]} · ${POS_N[dz.pos]} · `:p.views?`${VIEW_N[dz.view]} · `:"")+`Tamaño ${dz.scale}%`,pcs,logos:fbxLogosPara(p.id,dz.tech),file:dz.fileName,img:await thumb(dz.result)});
  saveCart();toast(`${p.name} agregado al carrito`);go("carrito");
});
function renderCart(){
  const box=document.getElementById("citems");
  if(!cart.length){box.innerHTML=`<div class="empty">Tu carrito está vacío.<br><br><button class="btn" data-go="disena">Diseña tu producto</button></div>`;}
  else box.innerHTML=cart.map(it=>`<article class="citem">
    <img src="${it.img}" alt="${it.name} en ${COLORS[it.color].n} con tu logo">
    <div style="min-width:0"><div class="sku">SKU: ${it.sku}</div><h3>${it.name}</h3>
      <p>${it.comp}</p>
      <div class="meta"><span class="pill"><span class="dot" style="background:${(COLORS[it.color]||{}).h}"></span>${COLORS[it.color].n}</span><span class="pill">${TECH_NAME[it.tech]||it.tech}</span>${precioPill(it)}${it.place?`<span class="pill">Logo: ${it.place}</span>`:""}<span class="pill" title="${it.file}">Archivo: ${it.file.length>22?it.file.slice(0,20)+"…":it.file}</span></div></div>
    <div class="cqty"><div class="qty"><button type="button" data-cq="${it.id}:-1" aria-label="Menos">−</button><input type="number" min="1" value="${it.pcs}" data-ci="${it.id}" aria-label="Piezas"><button type="button" data-cq="${it.id}:1" aria-label="Más">+</button></div>
      <span style="font-size:12.5px;color:var(--muted)">piezas</span><button class="rm" data-rm="${it.id}">Quitar</button></div>
  </article>`).join("");
  document.getElementById("sumItems").textContent=cart.length;
  const totPcs=cart.reduce((a,b)=>a+b.pcs,0);document.getElementById("sumPcs").textContent=totPcs.toLocaleString("es-MX");
  const mn=document.getElementById("minNote");mn.classList.toggle("warn",cart.length>0&&totPcs<25);
  mn.textContent=cart.length&&totPcs<25?`Te faltan ${25-totPcs} piezas para el mínimo de compra (25 piezas). Puedes combinar colores y modelos.`:"Mínimo de compra: 25 piezas por pedido. Puedes combinar colores y modelos.";
  const lines=cart.map((it,i)=>`${i+1}) ${it.name} (SKU ${it.sku}) · ${COLORS[it.color].n} · ${TECH_NAME[it.tech]}${it.place?` (logo ${it.place.toLowerCase()})`:""} · ${it.pcs} pzs · Archivo: ${it.file}`);
  const msg=cart.length?`Hola, me gustaría cotizar este pedido de FB Custom:\n${lines.join("\n")}\nTotal: ${cart.reduce((a,b)=>a+b.pcs,0)} piezas.`:"Hola, me gustaría recibir asesoría para un pedido de FB Custom.";
  document.getElementById("waBtn").href=`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
  fbxActualizarResumen();
}
document.getElementById("citems").addEventListener("click",e=>{
  const q=e.target.closest("[data-cq]");if(q){const [id,dl]=q.dataset.cq.split(":");const it=cart.find(x=>x.id==id);it.pcs=Math.max(1,it.pcs+parseInt(dl));saveCart();renderCart();return;}
  const r=e.target.closest("[data-rm]");if(r){cart=cart.filter(x=>x.id!=r.dataset.rm);saveCart();renderCart();}
});
document.getElementById("citems").addEventListener("change",e=>{const i=e.target.closest("[data-ci]");if(!i)return;const it=cart.find(x=>x.id==i.dataset.ci);it.pcs=Math.max(1,parseInt(i.value)||1);saveCart();renderCart();});
