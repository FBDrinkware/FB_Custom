<script>
/* ================================================================
   FB DRINKWARE — CONEXIÓN DEL SITIO CON SHEETS Y PANEL (v2)
   No cambia estilos. Hace que el Sheet de productos sea la fuente
   de los vasos (SKU, color, precio, estatus, foto), lee categorías y
   colores del Sheet, calcula el precio por técnica, agrega al carrito
   sin diseñar, registra el pedido en el panel y abre WhatsApp.
   ================================================================ */
const FBX = {
  SHEET_URL: 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTCuUsbKuOYH_2NKSFUE3F83riH5dQYYhb71wuGHy-FvIE583Mu6-ERJHOTnpP-7pQ-fJpk1cMjvpGM/pub?output=csv',
  APPS_SCRIPT_URL: 'https://script.google.com/macros/s/AKfycbzCugCj5h8W5Gfh7nlmvwXGzeenFdoqxyzbgZCOubGSFO9rHxEHkvggoJw36EF9Wa3M/exec',
  WA_DEFAULT: '5219981951897',
  PZS_DEFAULT: 25,
  // Precio extra por pieza (con IVA). Se pueden cambiar en la hoja Guia:
  // PRECIO_LOGO_EXTRA · PRECIO_360 · PRECIO_DTF
  TEC_PRECIO: { logoExtra: 15, '360': 50, dtf: 70 },
  precios: {}, nombres: {}, estatus: {}, preciosAsesor: {},
  promos: {},
  tec: {},    // tarjeta → técnica elegida (laser por defecto)
  logos: {},  // tarjeta → número de logos (láser)
  asesor: { codigo: 'FBDE-0', nombre: 'FB Drinkware', canal: 'FB Drinkware' },
  externo: false,
  hojaCargada: false,
};
const FBX_CODIGO_CATS = new Set(['gorras', 'playeras']); // categorías que siguen definidas en el código

/* ---------- utilidades ---------- */
function fbxCSVLine(line) {
  const r = []; let cur = '', q = false;
  for (let i = 0; i < line.length; i++) {
    const c = line[i];
    if (q) { if (c === '"' && line[i + 1] === '"') { cur += '"'; i++; } else if (c === '"') q = false; else cur += c; }
    else { if (c === '"') q = true; else if (c === ',') { r.push(cur.trim()); cur = ''; } else cur += c; }
  }
  r.push(cur.trim()); return r;
}
/* Divide el CSV en filas respetando saltos de línea dentro de comillas */
function fbxCSVRows(txt) {
  const out = []; let cur = '', q = false;
  for (let i = 0; i < txt.length; i++) {
    const c = txt[i];
    if (c === '"') { q = !q; cur += c; }
    else if ((c === '\n' || c === '\r') && !q) { if (c === '\r' && txt[i + 1] === '\n') i++; out.push(cur); cur = ''; }
    else cur += c;
  }
  if (cur) out.push(cur);
  return out;
}
function fbxCelda(v) {
  if (!v) return '';
  v = v.replace(/^"+|"+$/g, '').trim();
  const m = v.match(/^=?HYPERLINK\s*\(\s*"([^"]+)"/i);
  return m ? m[1] : v;
}
const fbxNorm = s => (s || '').toString().trim().normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const fbxMoney = n => '$' + Number(n || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fbxParam = k => new URLSearchParams(location.search).get(k);
function fbxSku(p, color) { return p && p.sheet ? color : (p ? p.sku : ''); }

/* ---------- precios ---------- */
function fbxPrecioBase(sku) {
  const base = FBX.precios[(sku || '').toUpperCase()];
  if (!base) return null;
  const pr = FBX.promos[(sku || '').toUpperCase()] || FBX.promos.__TODOS__;
  if (!pr || !pr.valorDescuento) return base;
  const f = pr.tipoDescuento === 'porcentaje' ? base * (1 - pr.valorDescuento / 100) : base - pr.valorDescuento;
  return Math.max(0, Math.round(f * 100) / 100);
}
/* Cargo por pieza de la técnica: láser 1 logo gratis, cada logo extra $15; 360° $50; DTF $70 */
function fbxPrecioTec(tech, logos) {
  if (tech === 'laser') return Math.max(0, (Number(logos) || 1) - 1) * FBX.TEC_PRECIO.logoExtra;
  if (tech === '360') return FBX.TEC_PRECIO['360'];
  if (tech === 'dtf') return FBX.TEC_PRECIO.dtf;
  return 0;
}
/* Nombre de la técnica como llega al panel (identifica la línea junto con el SKU) */
function fbxTecNombre(tech, logos) {
  if (tech === 'laser') return (Number(logos) || 1) > 1 ? `Grabado láser (${logos} logos)` : 'Grabado láser';
  if (tech === '360') return 'Grabado 360°';
  if (tech === 'dtf') return 'DTF';
  return (typeof TECH_NAME !== 'undefined' && TECH_NAME[tech]) || tech || '';
}
function fbxUnit(it) {
  const b = fbxPrecioBase(it.sku);
  return b == null ? null : b + fbxPrecioTec(it.tech, it.logos);
}
function fbxTecPara(pid) { return FBX.tec[pid] || 'laser'; }
function fbxLogosPara(pid, tech) { return tech === 'laser' ? (FBX.logos[pid] || 1) : 1; }

/* ---------- piezas de HTML (solo clases existentes) ---------- */
function precioHtml(p, sel) {
  if (FBX.externo || !FBX.hojaCargada) return '';
  const sku = fbxSku(p, sel), base = fbxPrecioBase(sku), lista = FBX.precios[(sku || '').toUpperCase()];
  if (base == null) return `<div class="cname">Precio: <b>a cotizar</b></div>`;
  const key = p.id, tech = p.sheet ? fbxTecPara(key) : null, logos = fbxLogosPara(key, tech);
  const extra = tech ? fbxPrecioTec(tech, logos) : 0;
  const tachado = lista && base < lista ? ` <span style="color:var(--muted);text-decoration:line-through">${fbxMoney(lista)}</span>` : '';
  const desglose = extra > 0 ? ` <span style="color:var(--muted)">(${fbxMoney(base)} + ${fbxTecNombre(tech, logos)} ${fbxMoney(extra)})</span>` : (tech === 'laser' ? ` <span style="color:var(--muted)">· 1 logo láser incluido</span>` : '');
  return `<div class="cname">Precio: <b>${fbxMoney(base + extra)}</b>${tachado} c/u · IVA incluido${desglose}</div>`;
}
/* Selector de técnica (y logos si es láser) en las tarjetas de vasos */
function tecHtml(p) {
  if (!p.sheet) return '';
  const k = p.id, t = fbxTecPara(k), n = FBX.logos[k] || 1;
  const b = (attr, val, on, txt) => `<button type="button" ${attr}="${k}:${val}" class="${on ? 'on' : ''}" aria-pressed="${on}">${txt}</button>`;
  return `<div class="segs">
      <div class="seg" role="group" aria-label="Técnica">${b('data-tec', 'laser', t === 'laser', 'Grabado láser')}${b('data-tec', '360', t === '360', '360°')}${b('data-tec', 'dtf', t === 'dtf', 'DTF')}</div>
      ${t === 'laser' ? `<div class="seg" role="group" aria-label="Logos">${b('data-logos', 1, n === 1, '1 logo')}${b('data-logos', 2, n === 2, '2')}${b('data-logos', 3, n === 3, '3')}</div>` : ''}
    </div>`;
}
function precioPill(it) {
  const logos = it.tech === 'laser' && (it.logos || 1) > 1 ? `<span class="pill">${it.logos} logos</span>` : '';
  if (FBX.externo) return logos;
  const u = fbxUnit(it);
  return logos + (u == null ? '' : `<span class="pill">${fbxMoney(u)} c/u</span>`);
}
function fbxSubtotal() {
  return (typeof cart !== 'undefined' ? cart : []).reduce((s, it) => s + (fbxUnit(it) || 0) * it.pcs, 0);
}
function fbxActualizarResumen() {
  const row = document.getElementById('sumAmtRow');
  if (!row) return;
  row.hidden = FBX.externo || !FBX.hojaCargada;
  document.getElementById('sumAmt').textContent = fbxMoney(fbxSubtotal());
}

/* ---------- carga: asesor, configuración (promos, categorías, colores) ---------- */
async function fbxCargarAsesor() {
  const cod = (fbxParam('asesor') || 'FBDE-0').trim();
  WHATSAPP = FBX.WA_DEFAULT;
  if (cod.toUpperCase() === 'FBDE-0') return;
  try {
    const d = await (await fetch(`${FBX.APPS_SCRIPT_URL}?action=getAsesor&codigo=${encodeURIComponent(cod)}`)).json();
    if (!d.ok || !d.asesor) return;
    FBX.asesor = d.asesor;
    WHATSAPP = d.asesor.telefono || FBX.WA_DEFAULT;
    FBX.externo = d.asesor.canal === 'Externo';
  } catch (e) { console.warn('getAsesor falló, se usa FB Drinkware', e); }
}

async function fbxCargarConfig() {
  try {
    const d = await (await fetch(`${FBX.APPS_SCRIPT_URL}?action=getConfigCatalogo`)).json();
    if (!d.ok) return;
    FBX.promos = {};
    (d.promos || []).forEach(pr => { FBX.promos[pr.skuAplica === 'TODOS' ? '__TODOS__' : pr.skuAplica] = pr; });
    const g = d.guia || {}, num = v => { const n = parseFloat(v); return isNaN(n) ? null : n; };
    if (num(g.PRECIO_LOGO_EXTRA) != null) FBX.TEC_PRECIO.logoExtra = num(g.PRECIO_LOGO_EXTRA);
    if (num(g.PRECIO_360) != null) FBX.TEC_PRECIO['360'] = num(g.PRECIO_360);
    if (num(g.PRECIO_DTF) != null) FBX.TEC_PRECIO.dtf = num(g.PRECIO_DTF);
    // Familias de color (filtro "Colores")
    (d.colores || []).forEach(c => {
      const hx = (c.hex || '').split(',').map(s => s.trim()).filter(Boolean);
      const h = hx.length > 1 ? `linear-gradient(135deg,${hx[0]},${hx[1]})` : (hx[0] || (COLORS[c.clave] && COLORS[c.clave].h) || '#BFC3C9');
      COLORS[c.clave] = { n: c.nombre, h };
    });
    FBX.categorias = d.categorias || [];
  } catch (e) { console.warn('getConfigCatalogo falló', e); }
}

/* Aplica la hoja Categorias: nombre, subtítulo, orden y estado (Activa / Próximamente / Oculta) */
function fbxAplicarCategorias() {
  const lista = (FBX.categorias || []).slice().sort((a, b) => a.orden - b.orden);
  if (!lista.length) return;
  const viejo = Object.assign({}, CATS);
  Object.keys(CATS).forEach(k => delete CATS[k]);
  lista.forEach(c => {
    const est = fbxNorm(c.estado);
    if (est === 'oculta') return;
    CATS[c.clave] = Object.assign({}, viejo[c.clave] || {}, { n: c.nombre, sub: c.subtitulo || (viejo[c.clave] || {}).sub || '' });
    if (est.startsWith('proxim')) SOON.add(c.clave); else SOON.delete(c.clave);
  });
  // Las categorías del código que no estén en la hoja se conservan al final
  Object.keys(viejo).forEach(k => { if (!CATS[k] && !lista.some(c => c.clave === k)) CATS[k] = viejo[k]; });
  // Productos de categorías ocultas fuera
  for (let i = PRODUCTS.length - 1; i >= 0; i--) if (!CATS[PRODUCTS[i].cat]) PRODUCTS.splice(i, 1);
  for (let i = DESIGN_PRODUCTS.length - 1; i >= 0; i--) if (!CATS[DESIGN_PRODUCTS[i].cat] || SOON.has(DESIGN_PRODUCTS[i].cat)) DESIGN_PRODUCTS.splice(i, 1);
}

/* ---------- carga: Sheet de productos ---------- */
async function fbxCargarProductos() {
  try {
    const r = await fetch(FBX.SHEET_URL);
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const filas = fbxCSVRows(await r.text());
    const h = fbxCSVLine(filas[0] || '').map(x => fbxNorm(fbxCelda(x)).toUpperCase());
    const col = name => h.indexOf(name);
    const iColor = col('COLOR'), iHex = col('HEX'), iFam = col('FAMILIA'), iCat = col('CATEGORIA'), iLimpia = col('IMAGEN_LIMPIA');
    const iAsesor = FBX.externo ? col('PRECIO_' + (FBX.asesor.codigo || '').toUpperCase()) : -1;
    const rows = [];
    filas.slice(1).forEach(f => {
      if (!f.trim()) return;
      const c = fbxCSVLine(f).map(fbxCelda);
      // Mismas posiciones que el catálogo actual: A SKU · B Nombre · C Precio · D Imagen · E Capacidad · F Estatus
      const sku = (c[0] || '').trim();
      if (!sku) return;
      const K = sku.toUpperCase();
      FBX.nombres[K] = c[1] || '';
      FBX.precios[K] = parseFloat((c[2] || '').replace(/[$,\s]/g, '')) || 0;
      FBX.estatus[K] = c[5] || '';
      if (iAsesor >= 0) { const pa = parseFloat(c[iAsesor]); if (pa > 0) FBX.preciosAsesor[K] = pa; }
      rows.push({
        sku, nombre: c[1] || '', img: c[3] || '', cap: c[4] || '', estatus: c[5] || '',
        color: iColor >= 0 ? c[iColor] : '', hex: iHex >= 0 ? c[iHex] : '',
        fam: iFam >= 0 ? fbxNorm(c[iFam]) : '', cat: iCat >= 0 ? fbxNorm(c[iCat]) : '',
        limpia: iLimpia >= 0 ? c[iLimpia] : '',
      });
    });
    FBX.hojaCargada = true;
    fbxConstruirDesdeHoja(rows);
  } catch (e) { console.warn('No se pudo leer el Sheet de productos; se usan los vasos del código', e); }
}

/* Arma las tarjetas de vasos (y de categorías nuevas) desde las filas del Sheet:
   una tarjeta por categoría + capacidad; cada fila es un color con su propio SKU. */
function fbxConstruirDesdeHoja(rows) {
  const grupos = {};
  rows.forEach(x => {
    const cat = x.cat || 'drinkware';
    if (FBX_CODIGO_CATS.has(cat)) return;               // gorras/playeras siguen en el código (solo toman precio)
    if (fbxNorm(x.estatus).includes('inactivo')) return; // oculto
    const oz = parseFloat((x.cap.match(/[\d.]+/) || [])[0]);
    const key = cat === 'drinkware' && oz ? 's' + oz : `${cat}_${oz || fbxNorm(x.nombre).split(' ').slice(0, 2).join('_')}`;
    (grupos[key] = grupos[key] || { key, cat, oz, filas: [] }).filas.push(x);
  });

  const presentes = new Set(Object.keys(grupos));
  // Capacidades de vasos que ya no tienen filas activas → fuera
  for (let i = PRODUCTS.length - 1; i >= 0; i--) {
    const p = PRODUCTS[i];
    if (p.sheet && !presentes.has(p.id)) {
      PRODUCTS.splice(i, 1);
      const j = DESIGN_PRODUCTS.indexOf(p); if (j >= 0) DESIGN_PRODUCTS.splice(j, 1);
    }
  }

  Object.values(grupos).forEach(g => {
    const key = g.key;
    IMGS[key] = IMGS[key] || {}; CLEAN[key] = CLEAN[key] || {}; PHOTO[key] = key;
    const v = {}, tag = {}, colors = [];
    g.filas.forEach(x => {
      const code = x.sku;
      const previo = COLORS[code] || {};
      const hx = (x.hex || '').split(',').map(s => s.trim()).filter(Boolean);
      const etiqueta = x.color || previo.n || titleCase((x.nombre.split(/\bOZ\b/i)[1] || x.nombre).trim());
      COLORS[code] = {
        n: etiqueta,
        h: hx.length > 1 ? `linear-gradient(135deg,${hx[0]},${hx[1]})` : (hx[0] || previo.h || '#BFC3C9'),
        fam: x.fam || previo.fam || 'gris',
      };
      if (!COLORS[COLORS[code].fam]) COLORS[COLORS[code].fam] = { n: titleCase(COLORS[code].fam), h: hx[0] || '#BFC3C9' };
      if (!IMGS[key][code] && x.img) IMGS[key][code] = x.img;            // foto del Sheet si el código no la trae
      if (!CLEAN[key][code] && (x.limpia || x.img)) CLEAN[key][code] = x.limpia || x.img;
      const cap = x.cap ? x.cap.replace(/Oz/g, 'oz') : (g.oz ? `${g.oz} oz` : '');
      v[code] = { name: titleCase(x.nombre), cap };
      const t = STATUS_N(x.estatus); if (t) tag[code] = t;
      colors.push(code);
    });
    if (!colors.length) return;
    let p = PRODUCTS.find(q => q.id === key);
    if (!p) {
      const first = (g.filas[0].nombre.split(' ')[0] || '').toUpperCase();
      const kind = first.startsWith('CILINDRO') ? 'Cilindros térmicos' : first.startsWith('TAZA') ? 'Tazas térmicas'
        : first.startsWith('VASO') ? 'Vasos térmicos' : titleCase(g.filas[0].nombre.split(' ').slice(0, 2).join(' '));
      TNAME[key] = kind;
      p = { id: key, cat: g.cat, type: key, name: g.oz ? `${kind} ${g.oz} oz` : kind, comp: g.cat === 'drinkware' ? 'Acero inoxidable' : '', date: 100 - (g.oz || 0) };
      PRODUCTS.push(p);
    }
    p.sheet = v; p.vtag = tag; p.colors = colors;
    p.sku = colors[0].split('-')[0] + '-xx';
    // Sin zona de logo calibrada (forma nueva) → sin diseñador, solo "Añadir"
    p.noDesign = !(DZONES[key] || ZONES[key]);
    if (!p.noDesign && !DESIGN_PRODUCTS.includes(p) && !SOON.has(p.cat)) DESIGN_PRODUCTS.push(p);
    if (!colors.includes(state.sel[key])) state.sel[key] = colors.find(c => tag[c] !== '¡AGOTADO!') || colors[0];
    if (!catCover[p.cat]) catCover[p.cat] = [key, state.sel[key]];
  });
}

/* ---------- añadir sin diseñar ---------- */
function fbxAnadir(key) {
  const pid = key.split('@')[0];
  const p = PRODUCTS.find(x => x.id === pid);
  if (!p) return;
  const color = state.sel[key] || p.colors[0];
  if (p.vtag && p.vtag[color] === '¡AGOTADO!') { toast('Ese color está agotado. Elige otro.'); return; }
  const tech = p.sheet ? fbxTecPara(pid) : ((techsOf(p) || [])[0] || {}).id || '';
  const logos = fbxLogosPara(pid, tech);
  const sku = fbxSku(p, color);
  const igual = cart.find(it => it.sku === sku && it.tech === tech && (it.logos || 1) === logos && it.sinDiseno);
  if (igual) igual.pcs += FBX.PZS_DEFAULT;
  else {
    const set = IMGS[p.type === 'perf' ? 'perf_frente' : PHOTO[p.type]] || {};
    cart.push({
      id: Date.now(), pid, sinDiseno: true,
