  const n=dots.length;let i=0,timer=null;const still=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const to=k=>{i=(k+n)%n;tr.scrollTo({left:i*tr.clientWidth,behavior:still?"auto":"smooth"});};
  tr.addEventListener("scroll",()=>{const k=Math.round(tr.scrollLeft/Math.max(1,tr.clientWidth));if(k!==i&&k>=0&&k<n)i=k;dots.forEach((d,j)=>d.classList.toggle("on",j===i));},{passive:true});
  dots.forEach((d,j)=>d.addEventListener("click",()=>{to(j);restart();}));
  document.querySelectorAll("[data-fbd]").forEach(b=>b.addEventListener("click",()=>{to(i+parseInt(b.dataset.fbd));restart();}));
