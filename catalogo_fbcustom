(function(){const tr=document.getElementById("hcTrack");const dots=[...document.querySelectorAll("#hcDots button")];const n=dots.length;let i=0,timer=null;
  const still=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const to=k=>{i=(k+n)%n;tr.scrollTo({left:i*tr.clientWidth,behavior:still?"auto":"smooth"});};
  const slides=[...tr.children];const mq=window.matchMedia("(max-width:700px)");
  const fit=()=>{tr.style.height=mq.matches?slides[i].offsetHeight+"px":"";};
  tr.addEventListener("scroll",()=>{const k=Math.round(tr.scrollLeft/Math.max(1,tr.clientWidth));if(k>=0&&k<n&&k!==i){i=k;fit();}dots.forEach((d,j)=>d.classList.toggle("on",j===i));},{passive:true});
  window.addEventListener("load",fit);setTimeout(fit,50);
  dots.forEach((d,j)=>d.addEventListener("click",()=>{to(j);restart();}));
  document.querySelectorAll("[data-hc]").forEach(b=>b.addEventListener("click",()=>{to(i+parseInt(b.dataset.hc));restart();}));
  const play=()=>{if(still)return;stop();timer=setInterval(()=>{if(document.getElementById("v-inicio").classList.contains("on")&&!document.hidden)to(i+1);},6500);};
  const stop=()=>{clearInterval(timer);timer=null;};const restart=()=>{stop();play();};
  const box=document.getElementById("hc");box.addEventListener("mouseenter",stop);box.addEventListener("mouseleave",play);
  box.addEventListener("focusin",stop);box.addEventListener("focusout",play);box.addEventListener("touchstart",stop,{passive:true});
  window.addEventListener("resize",()=>{to(i);fit();});play();})();
