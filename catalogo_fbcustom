function showErr(m){ferr.textContent=m;ferr.hidden=!m;}
function readAs(file,how){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=()=>rej(r.error);r[how](file);});}
function loadImg(src){return new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=()=>rej(new Error("img"));i.src=src;});}
function loadScript(src){return new Promise((res,rej)=>{const s=document.createElement("script");s.src=src;s.onload=res;s.onerror=rej;document.head.appendChild(s);});}
let pdfReady=null;
function ensurePdf(){
  if(!pdfReady){const base="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/";
    pdfReady=loadScript(base+"pdf.min.js").then(()=>loadScript(base+"pdf.worker.min.js")).then(()=>{window.pdfjsLib.GlobalWorkerOptions.workerSrc=base+"pdf.worker.min.js";});}
  return pdfReady;
}
async function handleFile(file){
  showErr("");const ext=(file.name.split(".").pop()||"").toLowerCase();
  if(!["png","jpg","jpeg","svg","pdf","ai"].includes(ext)){showErr("Ese formato no es compatible. Sube un archivo PNG, JPG, SVG, PDF o AI.");return;}
  if(file.size>25*1024*1024){showErr("El archivo pesa más de 25 MB. Exporta una versión más ligera e inténtalo de nuevo.");return;}
  try{
    let cv;
    if(ext==="pdf"||ext==="ai"){
      await ensurePdf();
      const buf=await readAs(file,"readAsArrayBuffer");
      const doc=await window.pdfjsLib.getDocument({data:new Uint8Array(buf)}).promise;
      const page=await doc.getPage(1);const v0=page.getViewport({scale:1});
      const sc=Math.min(4,1400/Math.max(v0.width,v0.height));const vp=page.getViewport({scale:sc});
      cv=document.createElement("canvas");cv.width=Math.round(vp.width);cv.height=Math.round(vp.height);
      await page.render({canvasContext:cv.getContext("2d"),viewport:vp,background:"rgba(0,0,0,0)"}).promise;
    }else{
      const url=await readAs(file,"readAsDataURL");const im=await loadImg(url);
      let w=im.naturalWidth||1000,h=im.naturalHeight||1000;const sc=Math.min(1,1400/Math.max(w,h));
      if(ext==="svg"&&Math.max(w,h)<1000){const k=1000/Math.max(w,h);w*=k;h*=k;}else{w*=sc;h*=sc;}
      cv=document.createElement("canvas");cv.width=Math.round(w);cv.height=Math.round(h);cv.getContext("2d").drawImage(im,0,0,cv.width,cv.height);
    }
    dz.rawLogo=cv;dz.fileName=file.name;
    document.getElementById("rmBg").checked=!hasTransparency(cv);
    prepLogo();dz.result=null;
    document.getElementById("fname").textContent=file.name;
    document.getElementById("filebox").hidden=false;document.getElementById("to3").disabled=false;
  }catch(err){
    showErr(ext==="ai"?"No pudimos leer este archivo .ai. Guárdalo desde Illustrator con la opción “Crear archivo compatible con PDF” o expórtalo como PDF o PNG.":
      "No pudimos leer el archivo. Revisa que no esté dañado o protegido con contraseña e inténtalo de nuevo.");
  }
}
function hasTransparency(cv){const d=cv.getContext("2d").getImageData(0,0,cv.width,cv.height).data;let t=0;for(let i=3;i<d.length;i+=16)if(d[i]<200)t++;return t>(d.length/16)*0.02;}
function prepLogo(){
  const src=dz.rawLogo,c=document.createElement("canvas");c.width=src.width;c.height=src.height;const x=c.getContext("2d");x.drawImage(src,0,0);
  const id=x.getImageData(0,0,c.width,c.height),d=id.data;
  if(document.getElementById("rmBg").checked){
    for(let i=0;i<d.length;i+=4){const m=Math.min(d[i],d[i+1],d[i+2]);if(m>238)d[i+3]=0;else if(m>214)d[i+3]=Math.round(d[i+3]*(238-m)/24);}
    x.putImageData(id,0,0);
  }
  let x0=c.width,y0=c.height,x1=-1,y1=-1;
