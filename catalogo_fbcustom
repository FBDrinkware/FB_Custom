}

/* ---------- datos del cliente en el resumen del carrito ---------- */
function fbxCampos() {
  const wa = document.getElementById('waBtn');
  if (!wa || document.getElementById('k-nombre')) return;
  const box = document.createElement('div');
  box.style.cssText = 'display:grid;gap:12px';
  box.innerHTML = `
    <div class="fld"><label for="k-nombre">Nombre completo</label><input id="k-nombre" autocomplete="name" required><span class="err"></span></div>
    <div class="fld"><label for="k-tel">Teléfono (WhatsApp)</label><input id="k-tel" type="tel" inputmode="tel" autocomplete="tel" placeholder="10 dígitos" required><span class="err"></span></div>
    <div class="fld"><label for="k-empresa">Empresa (opcional)</label><input id="k-empresa" autocomplete="organization"><span class="err"></span></div>
    <div class="fld"><label for="k-correo">Correo (opcional)</label><input id="k-correo" type="email" autocomplete="email"><span class="err"></span></div>`;
  wa.parentNode.insertBefore(box, wa);
  try {
    const g = JSON.parse(localStorage.getItem('fbcliente') || '{}');
    ['nombre', 'tel', 'empresa', 'correo'].forEach(k => { if (g[k]) document.getElementById('k-' + k).value = g[k]; });
  } catch (_) {}
}
function fbxValidar() {
  let ok = true;
  const set = (id, msg) => {
    const fld = document.getElementById(id).closest('.fld');
    fld.classList.toggle('bad', !!msg); fld.querySelector('.err').textContent = msg || '';
    if (msg) ok = false;
  };
  const nom = document.getElementById('k-nombre').value.trim();
  const tel = document.getElementById('k-tel').value.replace(/\D/g, '');
  const cor = document.getElementById('k-correo').value.trim();
  set('k-nombre', nom ? '' : 'Escribe tu nombre');
  set('k-tel', tel.length === 10 ? '' : 'Escribe un teléfono de 10 dígitos');
  set('k-correo', !cor || /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(cor) ? '' : 'Revisa el correo');
  if (!ok) document.querySelector('#csum .fld.bad input').focus();
  return ok;
}

/* ---------- envío: registro en el panel + WhatsApp ---------- */
function fbxIdPedido(now) {
  const dd = String(now.getDate()).padStart(2, '0'), mm = String(now.getMonth() + 1).padStart(2, '0');
  const t = String(now.getHours()).padStart(2, '0') + String(now.getMinutes()).padStart(2, '0');
  return `FBK-${dd}${mm}${now.getFullYear()}-${t}${String(Math.floor(10 + Math.random() * 90))}`;
}
function fbxEnviar(e) {
  e.preventDefault();
  if (!cart.length) { toast('Tu carrito está vacío.'); return; }
  const totPcs = cart.reduce((a, b) => a + b.pcs, 0);
  if (totPcs < 25) { toast(`Te faltan ${25 - totPcs} piezas para el mínimo de compra (25 piezas).`); return; }
  if (!fbxValidar()) return;

  const nom = document.getElementById('k-nombre').value.trim();
  const tel = document.getElementById('k-tel').value.replace(/\D/g, '');
  const emp = document.getElementById('k-empresa').value.trim();
  const cor = document.getElementById('k-correo').value.trim();
  try { localStorage.setItem('fbcliente', JSON.stringify({ nombre: nom, tel, empresa: emp, correo: cor })); } catch (_) {}

  const now = new Date();
  const pedidoId = fbxIdPedido(now);
  const fecha = `${String(now.getDate()).padStart(2, '0')}/${String(now.getMonth() + 1).padStart(2, '0')}/${now.getFullYear()}`;
  const hora = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
  const origen = fbxParam('utm_campaign') || 'directo';
  const verPrecio = !FBX.externo && FBX.hojaCargada;

  const lineas = cart.map((it, i) => {
    const u = verPrecio ? fbxUnit(it) : null;
    const diseno = it.sinDiseno ? 'sin diseño' : `${it.place ? `logo ${it.place.toLowerCase()} · ` : ''}archivo: ${it.file}`;
    return `${i + 1}) ${it.name} (SKU ${it.sku}) · ${COLORS[it.color].n} · ${fbxTecNombre(it.tech, it.logos)} · ${it.pcs} pzs${u != null ? ` · ${fbxMoney(u)} c/u` : ''} · ${diseno}`;
  });
  let msg = `Hola, me gustaría cotizar este pedido:\nPedido: ${pedidoId}\nNombre: ${nom}\nTeléfono: ${tel}\n`;
  if (emp) msg += `Empresa: ${emp}\n`;
  if (cor) msg += `Correo: ${cor}\n`;
  msg += `\n${lineas.join('\n')}\n\nTotal: ${totPcs} piezas.`;
  if (verPrecio) msg += `\nSubtotal de referencia: ${fbxMoney(fbxSubtotal())} MXN (IVA incluido).`;
  msg += `\n\nAsesor: ${FBX.asesor.codigo}\nCampaña: ${origen}`;
  if (cart.some(it => !it.sinDiseno)) msg += `\n\nTe adjunto mi logo en este chat.`;

  // WhatsApp primero (abrirlo después de esperar la red lo bloquea el navegador)
  window.open(`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`, '_blank');

  // Una línea por SKU + técnica (se suman piezas iguales)
  const lin = {};
  cart.forEach(it => {
    const tec = fbxTecNombre(it.tech, it.logos);
    const k = `${(it.sku || '').toUpperCase()}|${tec}`;
    const det = it.sinDiseno ? 'Sin diseño' : [it.place, `Archivo: ${it.file}`].filter(Boolean).join(' · ');
    if (!lin[k]) lin[k] = {
      sku: it.sku,
      descripcion: FBX.nombres[(it.sku || '').toUpperCase()] || it.name,
      cantidad: 0,
      precioUnit: fbxPrecioBase(it.sku) || 0,           // solo producto (BE)
      precioTecnica: fbxPrecioTec(it.tech, it.logos),   // técnica por pieza (BZ)
      tecnica: tec,                                     // BX
      detalle: [],                                      // BY
      precioAsesor: FBX.preciosAsesor[(it.sku || '').toUpperCase()],
    };
    lin[k].cantidad += it.pcs;
    if (!lin[k].detalle.includes(det)) lin[k].detalle.push(det);
  });
  const productos = Object.values(lin).map(l => Object.assign(l, { detalle: l.detalle.join(' | ') }));
  const payload = {
    action: 'registrarPedido',
    pedidoId, fecha, hora: hora + ' hrs',
    tipo: 'Pedido completo',
    asesor: FBX.asesor.codigo, asesorNombre: FBX.asesor.nombre || '',
    nombre: nom, telefono: tel, origen,
    empresa: emp, correo: cor,
    grabado: 'Sí', logo: cart.some(it => !it.sinDiseno) ? 'Sí' : 'Pendiente',
    productos,
  };
  fetch(FBX.APPS_SCRIPT_URL, {
    method: 'POST', mode: 'no-cors', keepalive: true,
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(payload),
  }).catch(err => console.warn('Registro en Sheets falló', err));

  cart = []; saveCart(); renderCart();
  toast(`Pedido ${pedidoId} enviado.`);
}

/* ---------- eventos y arranque ---------- */
document.addEventListener('DOMContentLoaded', async () => {
  fbxCampos();
  const wa = document.getElementById('waBtn');
  if (wa) wa.addEventListener('click', fbxEnviar);
  const grid = document.getElementById('grid');
  if (grid) grid.addEventListener('click', e => {
    const a = e.target.closest('[data-qadd]'); if (a) { fbxAnadir(a.dataset.qadd); return; }
    const t = e.target.closest('[data-tec]');
    if (t) { const [k, v] = t.dataset.tec.split(':'); FBX.tec[k] = v; renderGrid(); return; }
    const l = e.target.closest('[data-logos]');
    if (l) { const [k, v] = l.dataset.logos.split(':'); FBX.logos[k] = Number(v); renderGrid(); }
  });
  await fbxCargarAsesor();
  await fbxCargarConfig();
  fbxAplicarCategorias();
  await fbxCargarProductos();
  try { renderCatCards(); } catch (_) {}
  try { renderFilters(); renderGrid(); } catch (_) {}
  try { renderCart(); } catch (_) {}
});

</script>
