.sizer{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sz-btn{border:1.5px solid var(--line);background:var(--card);border-radius:10px;padding:9px 14px;font-family:var(--display);font-weight:700;font-size:14px;color:var(--ink)}
