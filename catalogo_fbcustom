#szVal{min-width:64px;text-align:center;font-family:var(--display);font-weight:700;font-size:18px;font-variant-numeric:tabular-nums;background:var(--lime);border-radius:10px;padding:8px 10px}
.sz-reset{background:none;border:0;color:var(--muted);text-decoration:underline;font-size:13px;padding:4px}
.sz-hint{margin:8px 0 0;font-size:12.5px;color:var(--muted)}

/* ===== Vistas del producto en la tarjeta ===== */
.views{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);display:flex;gap:2px;background:rgba(255,255,255,.92);border-radius:999px;padding:3px;box-shadow:0 2px 8px rgba(0,0,0,.12);z-index:2}
.views button{border:0;background:none;border-radius:999px;padding:4px 10px;font-size:12px;font-family:var(--display);font-weight:500;color:var(--ink-2)}
.views button.on{background:var(--ink);color:var(--lime)}
.zoomable.zoom .views{opacity:0;transition:opacity .15s}
#segView{margin-bottom:0}

/* ===== Variantes por color (polos) ===== */
.grid.variants{display:flex;flex-wrap:wrap;justify-content:center;gap:20px}
.grid.variants .card{flex:0 0 calc((100% - 60px)/4);max-width:calc((100% - 60px)/4)}
@media (max-width:1100px){.grid.variants .card{flex-basis:calc((100% - 40px)/3);max-width:calc((100% - 40px)/3)}}
@media (max-width:760px){.grid.variants .card{flex-basis:calc((100% - 20px)/2);max-width:calc((100% - 20px)/2)}}
@media (max-width:440px){.grid.variants .card{flex-basis:100%;max-width:100%}}

.tag.out{background:#B3261E;color:#fff}
.card .swatches .sw{flex:none}

/* ===== Próximamente ===== */
.soon{position:relative;cursor:default;overflow:hidden}
.cat.soon:hover{transform:none;box-shadow:none}
.cat.soon .ph{filter:blur(6px);opacity:.75}
.cat.soon .bar svg{opacity:.3}
.card.soon .soon-wrap{filter:blur(6px);opacity:.7;pointer-events:none;user-select:none;display:flex;flex-direction:column;gap:10px}
.soon-badge{position:absolute;left:50%;top:45%;transform:translate(-50%,-50%);background:var(--ink);color:var(--lime);font-family:var(--display);font-weight:700;letter-spacing:.16em;font-size:clamp(13px,1.4vw,16px);padding:10px 18px;border-radius:999px;white-space:nowrap;box-shadow:0 10px 24px rgba(0,0,0,.25);z-index:2}
</style>
