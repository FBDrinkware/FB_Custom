<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="FB CUSTOM: vasos, gorras y polos personalizados con tu logo. Grabado láser, bordado, DTF e impresión UV.">
<style>body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>FB Custom</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700&display=swap">
<style>
/* Layout (brandbook FB CUSTOM, propuesta 3 «Bloque»): barra blanca → hero lima → bandas claras → pie en Negro Grafito. Un solo tema claro por decisión de marca. */
:root{
  /* Lima Ácido 380 C · Azul Eléctrico 2727 C · Negro Grafito Neutral Black C · Blanco */
  --lime:#DBE442; --lime-soft:#F4F6D2; --blue:#1E8FFF;
  --orange:#1E8FFF; --orange-deep:#0B6FD6; --bright:#1E8FFF; --ink:#222223; --ink-2:#4A4A47;
  --paper:#F3F3EF; --card:#FFFFFF; --stone:#E7E7E1; --line:#DCDCD4; --muted:#6F6F69;
  --display:"Space Grotesk", "Helvetica Neue", Arial, sans-serif;
  --body:"Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
  --gut-l:max(16px, env(safe-area-inset-left,0px)); --gut-r:max(16px, env(safe-area-inset-right,0px));
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.55}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--card)}
a{color:inherit}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--orange);outline-offset:2px;border-radius:6px}
.wrap{max-width:1200px;margin:0 auto;padding-left:var(--gut-l);padding-right:var(--gut-r)}
h1,h2,h3{font-family:var(--display);text-wrap:balance;margin:0;letter-spacing:-.01em}

/* ---------- NAV ---------- */
header.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--card);border-bottom:1px solid var(--line)}
.nav-in{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16px;height:72px}
.logo{display:flex;align-items:center;gap:10px;text-decoration:none;cursor:pointer;background:none;border:0;padding:0}
.logo-mark{width:42px;height:42px;background:var(--orange);display:grid;place-items:center;color:#fff;font-family:var(--display);font-weight:900;font-size:19px;letter-spacing:-.04em;border-radius:4px}
.logo-word{font-family:var(--display);font-weight:800;line-height:.95;font-size:17px;color:var(--orange);text-align:left;text-transform:uppercase}
.menu{display:flex;justify-content:center;align-items:center;gap:6px}
.menu button.lnk{background:none;border:0;padding:9px 16px;border-radius:10px;font-weight:700;font-size:15px;color:var(--ink)}
.menu button.lnk:hover{background:var(--stone)}
.menu button.lnk.on{background:var(--orange);color:#fff}
.search{display:flex;align-items:center;gap:6px;margin-left:8px}
.search-btn{background:none;border:0;width:38px;height:38px;border-radius:10px;display:grid;place-items:center;color:var(--ink)}
.search-btn:hover{background:var(--stone)}
.search input{width:0;opacity:0;border:1px solid var(--line);border-radius:10px;height:38px;padding:0;font:inherit;transition:width .25s,opacity .2s,padding .25s;background:var(--paper);color:var(--ink)}
.search.open input{width:200px;opacity:1;padding:0 12px}
.right{display:flex;align-items:center;gap:8px}
.icon-btn{position:relative;background:none;border:0;width:40px;height:40px;border-radius:10px;display:grid;place-items:center;color:var(--ink)}
.icon-btn:hover{background:var(--stone)}
.badge[hidden]{display:none}
.badge{position:absolute;top:3px;right:3px;min-width:17px;height:17px;border-radius:9px;background:var(--orange);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center;padding:0 4px}
.btn{display:inline-flex;align-items:center;gap:8px;border:0;border-radius:10px;padding:11px 20px;font-weight:700;background:var(--orange);color:#fff;text-decoration:none;transition:background .15s}
.btn:hover{background:var(--orange-deep)}
.btn.ghost{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.5)}
.btn.ghost:hover{background:rgba(255,255,255,.1)}
.burger{display:none}
@media (max-width:860px){
  .nav-in{grid-template-columns:auto 1fr auto}
  .menu{position:absolute;left:0;right:0;top:72px;background:var(--card);flex-direction:column;align-items:stretch;padding:12px var(--gut-r) 16px var(--gut-l);border-bottom:1px solid var(--line);display:none}
  .menu.open{display:flex}
  .search{margin:6px 0 0}
  .search input{width:100%!important;opacity:1;padding:0 12px;flex:1}
  .burger{display:grid}
  .acct-label{display:none}
  .btn.acct{padding:11px 12px}
}

/* ---------- VIEWS ---------- */
.view{display:none}
.view.on{display:block}
.eyebrow{font-family:var(--display);font-weight:700;text-transform:uppercase;letter-spacing:.14em;font-size:12px;color:var(--orange)}

/* HERO */
.hero{position:relative;background:#0b0b0b;color:#fff;overflow:hidden}
.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% center}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,8,18,.94) 0%,rgba(5,8,18,.6) 38%,rgba(5,8,18,0) 66%)}
.hero .wrap{position:relative;z-index:1;padding-block:clamp(72px,11vw,150px)}
.hero h1{font-size:clamp(40px,6.4vw,82px);font-weight:900;line-height:.92;text-transform:uppercase;max-width:9.5em}
.hero h1 em{font-style:normal;color:var(--bright)}
.hero .eyebrow{color:var(--bright)}
.hero p{max-width:30em;color:#d9d4cf;font-size:17px;margin:22px 0 30px}
.hero .cta{display:flex;gap:12px;flex-wrap:wrap}
.hero-tags{display:flex;gap:22px;flex-wrap:wrap;margin-top:42px;font-size:13px;color:#bdb6b0}
.hero-tags b{display:block;font-family:var(--display);font-size:22px;color:#fff}

section.band{padding-block:clamp(48px,7vw,84px)}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:28px}
.sec-head h2{font-size:clamp(30px,4vw,44px);font-weight:900;text-transform:uppercase}

/* CATEGORY CARDS */
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
@media (max-width:820px){.cats{grid-template-columns:1fr}}
.cat{display:flex;flex-direction:column;border-radius:14px;overflow:hidden;background:var(--stone);text-decoration:none;color:inherit;border:0;padding:0;text-align:left;transition:transform .2s, box-shadow .2s}
.cat:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(20,20,20,.12)}
.cat .ph{aspect-ratio:5/4;display:grid;place-items:center;padding:24px}
.cat .ph{position:relative}
.cat .ph img{position:absolute;inset:9%;width:82%;height:82%;object-fit:contain;filter:drop-shadow(10px 14px 12px rgba(0,0,0,.2))}
.cat .bar{background:var(--orange);color:#fff;display:flex;justify-content:space-between;align-items:center;padding:14px 18px;font-family:var(--display);font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.cat .bar small{font-family:var(--body);font-weight:500;letter-spacing:0;text-transform:none;opacity:.85;font-size:12px;margin-left:auto;margin-right:10px}

/* HOW */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;counter-reset:s}
@media (max-width:820px){.steps{grid-template-columns:1fr}}
.step{border-top:3px solid var(--ink);padding-top:16px}
.step h3{font-size:20px;text-transform:uppercase;margin-bottom:6px}
.step h3::before{counter-increment:s;content:counter(s) ". ";color:var(--orange)}
.step p{margin:0;color:var(--ink-2)}

/* ---------- CATALOG ---------- */
.cat-top{background:var(--ink);color:#fff}
.cat-top .wrap{padding-block:36px}
.cat-top h1{font-size:clamp(32px,4.4vw,52px);font-weight:900;text-transform:uppercase}
.crumbs{font-size:13px;color:#b6afa9;margin-bottom:6px}
.crumbs button{background:none;border:0;color:inherit;padding:0;text-decoration:underline}
.catalog{display:grid;grid-template-columns:250px 1fr;gap:32px;padding-block:32px 72px}
@media (max-width:900px){.catalog{grid-template-columns:1fr}}
aside.filters{align-self:start;position:sticky;top:calc(env(safe-area-inset-top,0px) + 88px)}
@media (max-width:900px){aside.filters{position:static}}
.f-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.f-head h2{font-size:15px;text-transform:uppercase;letter-spacing:.08em}
.f-toggle{background:none;border:0;color:var(--muted);font-size:13px;text-decoration:underline;padding:0}
.f-body{display:flex;flex-direction:column;gap:22px}
.smart{position:relative}
.smart input{width:100%;height:42px;border:1px solid var(--line);border-radius:10px;padding:0 12px 0 36px;font:inherit;background:var(--card);color:var(--ink)}
.smart svg{position:absolute;left:11px;top:12px;color:var(--muted)}
.f-group h3{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;color:var(--ink)}
.f-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.f-list label{display:flex;align-items:center;gap:10px;padding:7px 4px;border-radius:8px;cursor:pointer;font-size:14.5px}
.f-list label:hover{background:var(--stone)}
.f-list .txt{flex:1}
.f-list .cnt{color:var(--muted);font-size:12px;font-variant-numeric:tabular-nums}
.f-list input{width:18px;height:18px;accent-color:var(--orange);margin:0;cursor:pointer}
.dot{width:18px;height:18px;border-radius:50%;border:1px solid rgba(0,0,0,.18);flex:none}
.clear{background:none;border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:13px;color:var(--ink-2)}
.clear:hover{border-color:var(--ink)}

.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.toolbar .count{color:var(--muted);font-size:14px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:#fff;border:0;border-radius:999px;padding:5px 10px;font-size:12.5px}
.sort{display:flex;align-items:center;gap:8px;font-size:14px}
.sort select{height:38px;border:1px solid var(--line);border-radius:10px;padding:0 10px;font:inherit;background:var(--card);color:var(--ink)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px;position:relative;min-width:0}
.card .media{background:var(--stone);border-radius:10px;aspect-ratio:1/1;display:grid;place-items:center;position:relative;overflow:hidden}
.card .media img{position:absolute;inset:8%;width:84%;height:84%;object-fit:contain;filter:drop-shadow(8px 12px 10px rgba(0,0,0,.18))}
.fav{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:#fff;border:0;display:grid;place-items:center;color:var(--ink);box-shadow:0 1px 4px rgba(0,0,0,.12)}
.fav.on{color:var(--orange)}
.fav.on svg{fill:var(--orange)}
.tag{position:absolute;top:10px;left:10px;background:var(--orange);color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:5px;text-transform:uppercase;letter-spacing:.04em}
.sku{font-size:12px;color:var(--muted);letter-spacing:.04em;font-variant-numeric:tabular-nums}
.card h3{font-size:18px;text-transform:uppercase;line-height:1.1}
.swatches{display:flex;flex-wrap:wrap;gap:6px}
.sw{width:22px;height:22px;border-radius:50%;border:1px solid rgba(0,0,0,.2);padding:0;position:relative}
.sw.on{box-shadow:0 0 0 2px var(--card),0 0 0 4px var(--ink)}
.cname{font-size:12.5px;color:var(--ink-2)}
.comp{border-top:1px dashed var(--line);padding-top:10px;font-size:12.5px;color:var(--ink-2);display:grid;gap:2px}
.comp b{font-family:var(--display);text-transform:uppercase;letter-spacing:.06em;font-size:11.5px;color:var(--ink)}
.card .add{margin-top:auto;justify-content:center;padding:10px;font-size:14px}
.card.ext h3{color:var(--ink)}
.empty{padding:48px 20px;text-align:center;border:1px dashed var(--line);border-radius:14px;color:var(--muted)}

.to-top{position:fixed;left:calc(18px + env(safe-area-inset-left,0px));bottom:calc(18px + env(safe-area-inset-bottom,0px));width:50px;height:50px;border-radius:50%;background:rgba(20,20,20,.08);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1.5px solid rgba(20,20,20,.25);color:var(--ink);display:grid;place-items:center;z-index:40;opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .2s,transform .2s}
.to-top.show{opacity:1;pointer-events:auto;transform:none}
.to-top:hover{background:var(--orange);border-color:var(--orange);color:#fff}

/* ---------- CONTACT ---------- */
.contact{display:grid;grid-template-columns:1fr 1.5fr;gap:48px;padding-block:56px 80px}
@media (max-width:900px){.contact{grid-template-columns:1fr;gap:28px}}
.contact h1{font-size:clamp(36px,5vw,58px);font-weight:900;text-transform:uppercase;line-height:.95}
.contact .lead{color:var(--ink-2);max-width:28em}
.cinfo{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:14px}
.cinfo li{display:flex;gap:12px;align-items:flex-start}
.cinfo svg{color:var(--orange);flex:none;margin-top:2px}
form.cform{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:clamp(20px,3vw,34px);display:grid;grid-template-columns:1fr 1fr;gap:18px 20px}
@media (max-width:600px){form.cform{grid-template-columns:1fr}}
.fld{display:flex;flex-direction:column;gap:7px;min-width:0}
.fld.full{grid-column:1/-1}
.fld label{font-weight:700;font-size:14px;color:var(--ink-2)}
.fld input,.fld select,.fld textarea{border:1px solid var(--line);background:var(--paper);border-radius:10px;height:46px;padding:0 14px;font:inherit;color:var(--ink);width:100%}
.fld textarea{height:150px;padding:12px 14px;resize:vertical}
.fld input:focus,.fld select:focus,.fld textarea:focus{outline:none;border-color:var(--orange);box-shadow:0 0 0 3px rgba(30,143,255,.22)}
.fld .err{color:#B3261E;font-size:12.5px;min-height:0}
.fld.bad input,.fld.bad select,.fld.bad textarea{border-color:#B3261E}
.form-foot{grid-column:1/-1;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.notice{background:var(--lime-soft);border:1px solid var(--lime);color:#3B3F0E;border-radius:10px;padding:12px 14px;font-size:14px;grid-column:1/-1}

/* ---------- FOOTER ---------- */
footer{background:var(--card);border-top:1px solid var(--line)}
.f-in{display:grid;grid-template-columns:1.2fr 1fr 1.2fr;gap:32px;padding-block:44px 28px}
@media (max-width:760px){.f-in{grid-template-columns:1fr}}
.social{display:flex;gap:10px;margin-top:22px}
.social a{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:var(--orange);border:1.5px solid var(--line);transition:all .15s}
.social a:hover{background:var(--orange);color:#fff;border-color:var(--orange)}
footer h4{font-family:var(--display);font-size:16px;margin:0 0 12px;text-transform:uppercase;letter-spacing:.05em}
.qlinks{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.qlinks button{background:none;border:0;padding:0;color:var(--ink-2);font-size:15px}
.qlinks button:hover{color:var(--orange)}
.copy{border-top:1px solid var(--line);text-align:center;font-size:13px;color:var(--muted);padding-block:18px}

/* ---------- MODAL ---------- */
.modal{position:fixed;inset:0;background:rgba(10,10,10,.55);z-index:80;display:grid;place-items:center;padding:16px}
.modal[hidden]{display:none!important}
.mbox{background:var(--card);border-radius:16px;width:min(420px,100%);padding:26px;position:relative}
.mbox h2{font-size:26px;text-transform:uppercase;font-weight:900}
.tabs{display:flex;background:var(--stone);border-radius:10px;padding:4px;margin:16px 0}
.tabs button{flex:1;border:0;background:none;padding:9px;border-radius:8px;font-weight:700;color:var(--ink-2)}
.tabs button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.1)}
.mbox form{display:grid;gap:12px}
.x{position:absolute;top:12px;right:12px}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 18px;border-radius:10px;font-size:14px;z-index:90;max-width:calc(100% - 32px)}

/* ---------- DISEÑALO ---------- */
.stepper{display:flex;gap:8px;list-style:none;margin:0;padding:0;counter-reset:st;flex-wrap:wrap}
.stepper li{display:flex;align-items:center;gap:10px;color:#9aa3b5;font-weight:700;font-size:14px}
.stepper li::before{counter-increment:st;content:counter(st);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;border:1.5px solid #4a5468;font-size:13px}
.stepper li:not(:last-child)::after{content:"";width:34px;height:1.5px;background:#4a5468;margin-left:4px}
.stepper li.on{color:#fff}
.stepper li.on::before{background:var(--orange);border-color:var(--orange);color:#fff}
.stepper li.done{color:#cfd6e6}
.stepper li.done::before{content:"✓";background:#fff;border-color:#fff;color:var(--ink)}
.dz-wrap{padding-block:32px 72px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:clamp(18px,3vw,30px)}
.panel h2{font-size:clamp(22px,2.6vw,28px);text-transform:uppercase;font-weight:900;margin-bottom:4px}
.panel .hint{color:var(--muted);margin:0 0 20px}
.pick{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:14px}
.pick button{background:var(--paper);border:1.5px solid var(--line);border-radius:12px;padding:10px;text-align:left;display:flex;flex-direction:column;gap:6px;color:var(--ink);transition:border-color .15s, box-shadow .15s}
.pick button:hover{border-color:#9fb4ee}
.pick button.on{border-color:var(--orange);box-shadow:0 0 0 3px rgba(30,143,255,.2)}
.pick .ph{background:var(--stone);border-radius:9px;aspect-ratio:1/1;position:relative}
.pick .ph img{position:absolute;inset:8%;width:84%;height:84%;object-fit:contain}
.pick b{font-family:var(--display);text-transform:uppercase;font-size:14px;line-height:1.15}
.pick small{color:var(--muted);font-size:12px}
.pick-color{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:20px;padding-top:18px;border-top:1px dashed var(--line)}
.pick-color .lbl{font-weight:700;font-size:14px}
.step-nav{display:flex;justify-content:space-between;gap:12px;margin-top:24px;flex-wrap:wrap}
.btn.sec{background:var(--card);color:var(--ink);border:1.5px solid var(--line)}
.btn.sec:hover{background:var(--stone)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.drop{border:2px dashed #b9c6e6;border-radius:14px;background:var(--paper);padding:36px 20px;text-align:center;display:grid;gap:10px;justify-items:center;transition:background .15s,border-color .15s}
.drop.over{background:var(--lime-soft);border-color:var(--orange)}
.drop svg{color:var(--orange)}
.drop p{margin:0;color:var(--ink-2)}
.drop small{color:var(--muted)}
.filebox{display:grid;grid-template-columns:200px 1fr;gap:20px;align-items:center;margin-top:20px}
@media (max-width:600px){.filebox{grid-template-columns:1fr}}
.checker{aspect-ratio:1/1;border-radius:12px;border:1px solid var(--line);background-color:#fff;background-image:linear-gradient(45deg,#e8ebf1 25%,transparent 25%),linear-gradient(-45deg,#e8ebf1 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e8ebf1 75%),linear-gradient(-45deg,transparent 75%,#e8ebf1 75%);background-size:18px 18px;background-position:0 0,0 9px,9px -9px,-9px 0;display:grid;place-items:center;overflow:hidden;max-width:100%}
.checker img{max-width:86%;max-height:86%;object-fit:contain}
.fmeta{display:grid;gap:10px;min-width:0}
.fmeta .fname{font-weight:700;overflow-wrap:anywhere}
.tgl{display:flex;align-items:center;gap:10px;font-size:14px;cursor:pointer}
.tgl input{width:18px;height:18px;accent-color:var(--orange)}
.ferr{background:#FDECEC;border:1px solid #F3B9B9;color:#8A1C1C;border-radius:10px;padding:10px 12px;font-size:14px}
.studio{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:28px}
@media (max-width:900px){.studio{grid-template-columns:1fr}}
.opts{display:grid;gap:20px;align-content:start}
.opts h3{font-size:13px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px}
.techs{display:grid;gap:10px}
.tech{display:flex;gap:12px;align-items:flex-start;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;cursor:pointer;background:var(--paper)}
.tech:has(input:checked){border-color:var(--orange);background:var(--lime-soft)}
.tech input{margin-top:3px;width:18px;height:18px;accent-color:var(--orange)}
.tech b{display:block}
.tech span{font-size:13px;color:var(--muted)}
.qty{display:flex;align-items:center;border:1.5px solid var(--line);border-radius:10px;width:max-content;background:var(--card)}
.qty button{width:40px;height:42px;border:0;background:none;font-size:18px;color:var(--ink)}
.qty input{width:70px;height:42px;border:0;text-align:center;font:inherit;font-weight:700;background:none;color:var(--ink);font-variant-numeric:tabular-nums}
.stage{background:radial-gradient(ellipse at 50% 40%,#fff 0%,var(--stone) 75%);border-radius:16px;aspect-ratio:1/1;max-width:100%;display:grid;place-items:center;position:relative;overflow:hidden;border:1px solid var(--line)}
.stage img{position:absolute;inset:6%;width:88%;height:88%;object-fit:contain}
.stage .state{position:absolute;inset:auto 0 16px;text-align:center;font-size:13px;color:var(--muted)}
.stage.busy::after{content:"Generando vista previa…";position:absolute;inset:0;display:grid;place-items:center;background:rgba(247,248,251,.7);font-weight:700;color:var(--ink)}
.result-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}

/* ---------- CARRITO ---------- */
.cart{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:28px;padding-block:32px 72px}
@media (max-width:900px){.cart{grid-template-columns:1fr}}
.citems{display:grid;gap:14px;align-content:start}
.citem{display:grid;grid-template-columns:120px minmax(0,1fr) auto;gap:16px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px}
@media (max-width:600px){.citem{grid-template-columns:90px minmax(0,1fr)}.citem .cqty{grid-column:1/-1;justify-self:start}}
.citem img{width:100%;aspect-ratio:1/1;object-fit:contain;background:var(--stone);border-radius:10px}
.citem h3{font-size:16px;text-transform:uppercase;line-height:1.15}
.citem p{margin:4px 0 0;color:var(--ink-2);font-size:13.5px}
.citem .meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.pill{background:var(--stone);border-radius:999px;padding:3px 10px;font-size:12px;color:var(--ink-2);display:inline-flex;align-items:center;gap:6px}
.pill .dot{width:12px;height:12px}
.cqty{display:grid;gap:8px;justify-items:end}
.rm{background:none;border:0;color:var(--muted);font-size:13px;text-decoration:underline;padding:0}
.rm:hover{color:#B3261E}
.csum{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;align-self:start;position:sticky;top:calc(env(safe-area-inset-top,0px) + 88px);display:grid;gap:14px}
.csum h2{font-size:20px;text-transform:uppercase}
.csum .row{display:flex;justify-content:space-between;font-size:14.5px;font-variant-numeric:tabular-nums}
.csum small{color:var(--muted);font-size:12.5px}
.wa{background:#1FA855;justify-content:center}
.wa:hover{background:#168A45}

/* ---------- ZOOM ---------- */
@media (hover:hover) and (pointer:fine){
  .zoomable{cursor:zoom-in}
  .zoomable img{transition:transform .28s ease}
  .zoomable.zoom img{transform:scale(2.4);transition:transform .2s ease}
  .zoomable.zoom .tag,.zoomable.zoom .fav,.zoomable.zoom .state{opacity:0;transition:opacity .15s}
}
@media (prefers-reduced-motion:reduce){.zoomable img{transition:none}}

/* ===== Identidad FB CUSTOM (brandbook propuesta 3) ===== */
h1,h2,h3,.cat-top h1,.sec-head h2,.card h3,.panel h2,.mbox h2,.contact h1,.citem h3,.csum h2{text-transform:none;letter-spacing:-.02em;font-weight:700}
.logo-h{height:30px;width:auto;display:block}
@media (max-width:520px){.logo-h{height:21px}.right{gap:2px}}
.logo-s{width:104px;height:auto;display:block}
.btn{background:var(--ink);color:var(--lime);border-radius:12px}
.btn:hover{background:#000}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.btn.ghost:hover{background:rgba(34,34,35,.08)}
.btn.sec{background:var(--card);color:var(--ink);border:1.5px solid var(--line)}
.menu button.lnk{font-family:var(--display);font-weight:500}
.menu button.lnk.on{background:var(--lime);color:var(--ink)}
.badge{background:var(--blue);color:#fff}
.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--ink);font-family:var(--display);font-weight:500;letter-spacing:.16em}
.eyebrow::before{content:"";width:10px;height:10px;border-radius:2px;background:var(--lime);flex:none}
.cat-top .eyebrow,.footer-dark .eyebrow{color:var(--lime)}
/* hero lima */
.hero{background:var(--lime);color:var(--ink)}
.hero::after{display:none}
.hero .hero-in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:clamp(24px,4vw,56px);align-items:center;padding-block:clamp(40px,6vw,80px)}
@media (max-width:860px){.hero .hero-in{grid-template-columns:1fr}}
.hero .eyebrow{color:var(--ink);font-size:11.5px}
.hero .eyebrow::before{background:var(--blue)}
.hero h1{font-size:clamp(44px,6vw,80px);line-height:.95;text-transform:none;max-width:none;margin-top:18px}
.hero h1 em{color:var(--blue);font-style:normal}
.hero h1 span{display:block;font-size:.42em;font-weight:500;line-height:1.2;margin-top:14px;letter-spacing:-.01em}
.hero p{color:var(--ink-2);font-size:17px;margin:20px 0 28px;max-width:32em}
.hero-tags{color:var(--ink-2);border-top:1.5px solid rgba(34,34,35,.18);padding-top:18px;margin-top:36px}
.hero-tags b{color:var(--ink);font-size:19px;font-weight:700}
.hero-photo{margin:0;border-radius:22px;overflow:hidden;aspect-ratio:4/3;background:#0b0b0b;max-width:100%}
.hero-photo img{position:static;width:100%;height:100%;object-fit:cover;object-position:72% center;display:block}
/* categorías */
.cat .bar{background:var(--lime);color:var(--ink);font-family:var(--display);font-weight:700;letter-spacing:.04em}
.cat:hover{box-shadow:0 14px 30px rgba(34,34,35,.14)}
.tag{background:var(--ink);color:var(--lime);font-family:var(--display);font-weight:500;letter-spacing:.08em}
.sku{font-family:var(--display)}
/* pasos con número en placa lima, como en el brandbook */
.step{border-top:2px solid var(--ink)}
.step h3{text-transform:none;font-size:21px}
.step h3::before{content:counter(s,decimal-leading-zero);display:inline-block;background:var(--lime);color:var(--ink);font-size:.62em;padding:2px 7px;border-radius:5px;margin-right:10px;vertical-align:.25em;font-weight:700}
/* encabezados internos en Negro Grafito */
.cat-top{background:var(--ink)}
.cat-top h1{color:#fff}
.crumbs{color:#B9B9B0}
.stepper li.on::before{background:var(--lime);border-color:var(--lime);color:var(--ink)}
.stepper li.done::before{background:#fff;border-color:#fff;color:var(--ink)}
.to-top:hover{background:var(--lime);border-color:var(--lime);color:var(--ink)}
.drop{border-color:#C9CB9A}
.drop svg{color:var(--ink)}
.cinfo svg{color:var(--blue)}
/* pie en negativo */
footer{background:var(--ink);color:#E9E9E2;border-top:0}
footer h4{color:var(--lime);font-family:var(--display);font-weight:500;letter-spacing:.14em;font-size:13px}
footer p{color:#B5B5AD!important}
footer .qlinks button{color:#D9D9D1}
footer .qlinks button:hover{color:var(--lime)}
footer .cinfo svg{color:var(--lime)}
.social a{color:var(--lime);border-color:rgba(255,255,255,.2)}
.social a:hover{background:var(--lime);color:var(--ink);border-color:var(--lime)}
footer .copy{border-top:1px solid rgba(255,255,255,.12);color:#9C9C94}
footer .logo-s{width:112px}

/* ===== Banner a todo lo ancho ===== */
.hero.banner{position:relative;background:#07090d;color:#fff;overflow:hidden;min-height:clamp(440px,46vw,640px);display:flex;align-items:center}
.hero.banner .banner-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:68% 48%}
.hero.banner::after{display:block;content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,9,13,.92) 0%,rgba(7,9,13,.72) 34%,rgba(7,9,13,.15) 62%,rgba(7,9,13,0) 80%)}
.hero.banner .banner-in{position:relative;z-index:1;padding-block:clamp(56px,7vw,96px);width:100%}
.hero.banner .eyebrow{color:#E9E9E2}
.hero.banner .eyebrow::before{background:var(--lime)}
.hero.banner h1{color:#fff;max-width:6.2em}
.hero.banner .banner-in > *{max-width:min(36em,46%)}
@media (max-width:700px){.hero.banner .banner-in > *{max-width:none}}
.hero.banner h1 span{color:#E9E9E2}
.hero.banner p{color:#C9C9C1;max-width:30em}
.btn.lime{background:var(--lime);color:var(--ink)}
.btn.lime:hover{background:#fff;color:var(--ink)}
.btn.ghost.light{color:#fff;border-color:rgba(255,255,255,.6)}
.btn.ghost.light:hover{background:rgba(255,255,255,.12)}
@media (max-width:700px){
  .hero.banner{align-items:flex-end;min-height:600px}
