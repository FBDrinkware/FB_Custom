  if(state.only&&p.id!==state.only)return false;
  if(state.cats.size&&!state.cats.has(p.cat))return false;
  if(state.colors.size&&!p.colors.some(c=>state.colors.has((COLORS[c]&&COLORS[c].fam)||c)))return false;
  if(state.q){const hay=norm([p.name,p.comp,p.sku,CATS[p.cat].n,p.colors.map(c=>COLORS[c].n).join(" ")].join(" "));
    if(!norm(state.q).split(/\s+/).filter(Boolean).every(w=>hay.includes(w)))return false;}
