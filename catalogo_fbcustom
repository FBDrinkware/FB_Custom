.hero-strip .hero-tags{grid-template-columns:repeat(2,minmax(0,1fr))}

.menu button.lnk{text-align:center;justify-content:center;align-items:center;line-height:1.2}
@media (min-width:861px){.menu{align-items:center}}
@media (max-width:860px){.menu .lnk,.menu .dd{width:100%}}

