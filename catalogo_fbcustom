/* ===== Carrusel del banner principal ===== */
.hc{position:relative;background:#07090d}
.hc-track{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain}
.hc-track::-webkit-scrollbar{display:none}
.hc-slide{flex:0 0 100%;scroll-snap-align:start;position:relative;min-width:0}
.hero.banner.hc-slide{aspect-ratio:1024/572;min-height:0}
.hero.banner.hc-slide .banner-bg{object-fit:contain;object-position:right center}
.hc-img{aspect-ratio:1024/572;background:#07090d}
.hc-img img{width:100%;height:100%;object-fit:cover;display:block}
.hc-cta{position:absolute;left:clamp(16px,3.2vw,44px);bottom:clamp(18px,4vw,48px);box-shadow:0 10px 24px rgba(0,0,0,.4);text-decoration:none}
