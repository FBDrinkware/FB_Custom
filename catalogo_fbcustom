/* ---- Carrusel del banner principal ---- */
function showOnly(pid){const p=PRODUCTS.find(x=>x.id===pid);state.colors.clear();state.q="";smart.value="";state.only=p.id;state.cats=new Set([p.cat]);go("catalogo");}
