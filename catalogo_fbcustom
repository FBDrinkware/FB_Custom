@media (max-width:760px){.hero-strip .hero-tags{grid-template-columns:repeat(2,minmax(0,1fr))}}
.hero-strip .hero-tags b{display:block;font-family:var(--display);font-size:19px;color:var(--ink)}

/* Banner: foto completa, sin recorte (respeta la proporción original 1560×1005) */
